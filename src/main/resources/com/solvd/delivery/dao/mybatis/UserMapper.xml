<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solvd.delivery.dao.mybatis.UserMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO Users (first_name, last_name, email, phone_number)
        VALUES (#{firstName}, #{lastName}, #{email}, #{phoneNumber})
    </insert>

    <update id="update">
        UPDATE Users
        SET first_name=#{firstName},
        last_name=#{lastName},
        email=#{email},
        phone_number=#{phoneNumber}
        WHERE id=#{id}
    </update>

    <select id="getByEmail" resultType="com.solvd.delivery.models.User">
        SELECT * FROM Users WHERE email = #{email}
    </select>

    <select id="getByPhoneNumber" resultType="com.solvd.delivery.models.User">
        SELECT * FROM Users WHERE phone_number = #{phoneNumber}
    </select>

    <select id="getById" resultType="com.solvd.delivery.models.User">
        SELECT * FROM Users WHERE id = #{id}
    </select>

    <select id="getAll" resultType="com.solvd.delivery.models.User">
        SELECT * FROM Users
    </select>

    <delete id="delete">
        DELETE FROM Users WHERE id = #{id}
    </delete>

</mapper>
