<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.delivery.dao.mybatis.UserMapper">

    <!-- Result mapping -->
    <resultMap id="UserResultMap" type="com.solvd.delivery.models.User">
        <id property="id" column="id"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="email" column="email"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="role" column="role"/>
    </resultMap>

    <!-- Select all users -->
    <select id="getAll" resultMap="UserResultMap">
        SELECT id, first_name, last_name, email, phone_number, role
        FROM Users
    </select>

    <!-- Select by ID -->
    <select id="getById" resultMap="UserResultMap" parameterType="long">
        SELECT id, first_name, last_name, email, phone_number, role
        FROM Users
        WHERE id = #{id}
    </select>

    <!-- Select by Email -->
    <select id="getByEmail" resultMap="UserResultMap" parameterType="String">
        SELECT id, first_name, last_name, email, phone_number, role
        FROM Users
        WHERE email = #{email}
    </select>

    <!-- Insert user -->
    <insert id="insert" parameterType="com.solvd.delivery.models.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO Users (first_name, last_name, email, phone_number, role)
        VALUES (#{firstName}, #{lastName}, #{email}, #{phoneNumber}, #{role})
    </insert>

    <!-- Update user -->
    <update id="update" parameterType="com.solvd.delivery.models.User">
        UPDATE Users
        SET first_name = #{firstName},
        last_name = #{lastName},
        email = #{email},
        phone_number = #{phoneNumber},
        role = #{role}
        WHERE id = #{id}
    </update>

    <!-- Delete user -->
    <delete id="delete" parameterType="long">
        DELETE FROM Users WHERE id = #{id}
    </delete>

</mapper>
